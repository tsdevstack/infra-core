// Rstest Snapshot v1

exports[`generateAppRunnerTf > snapshot > should match snapshot 1`] = `
"# App Runner for Next.js Services
# Generated by: npx tsdevstack infra:generate

# =============================================================================
# IAM Role for App Runner ECR Access
# =============================================================================

resource "aws_iam_role" "apprunner_ecr_access" {
  count = length(var.nextjs_services) > 0 ? 1 : 0

  name = "\${var.project_name}-\${var.environment}-apprunner-ecr"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action = "sts:AssumeRole"
      Effect = "Allow"
      Principal = {
        Service = "build.apprunner.amazonaws.com"
      }
    }]
  })

  tags = {
    Name        = "\${var.project_name}-\${var.environment}-apprunner-ecr"
    Environment = var.environment
    ManagedBy   = "tsdevstack"
  }
}

resource "aws_iam_role_policy_attachment" "apprunner_ecr_access" {
  count = length(var.nextjs_services) > 0 ? 1 : 0

  role       = aws_iam_role.apprunner_ecr_access[0].name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSAppRunnerServicePolicyForECRAccess"
}

# =============================================================================
# Auto-Scaling Configuration (per service)
# =============================================================================

resource "aws_apprunner_auto_scaling_configuration_version" "nextjs" {
  for_each = var.nextjs_services

  auto_scaling_configuration_name = "\${var.project_name}-\${var.environment}-\${each.key}"

  min_size = max(each.value.minInstances, 1)  # App Runner minimum is 1
  max_size = each.value.maxInstances

  tags = {
    Name        = "\${var.project_name}-\${var.environment}-\${each.key}-scaling"
    Environment = var.environment
    ManagedBy   = "tsdevstack"
  }
}

# =============================================================================
# Origin Protection: WAF Web ACL for App Runner
# =============================================================================
# Validates X-Origin-Verify header to ensure traffic comes from CloudFront.
# Direct access to App Runner URL returns 403.

resource "random_password" "apprunner_origin_secret" {
  count   = length(var.nextjs_services) > 0 ? 1 : 0
  length  = 32
  special = false
}

resource "aws_wafv2_web_acl" "apprunner" {
  count = length(var.nextjs_services) > 0 ? 1 : 0

  name        = "\${var.project_name}-\${var.environment}-apprunner-waf"
  description = "Origin protection for App Runner - validates CloudFront header"
  scope       = "REGIONAL"

  default_action {
    block {}
  }

  # Rule: Allow requests with valid X-Origin-Verify header
  rule {
    name     = "allow-cloudfront-origin"
    priority = 1

    action {
      allow {}
    }

    statement {
      byte_match_statement {
        field_to_match {
          single_header {
            name = "x-origin-verify"
          }
        }
        positional_constraint = "EXACTLY"
        search_string         = random_password.apprunner_origin_secret[0].result
        text_transformation {
          priority = 0
          type     = "NONE"
        }
      }
    }

    visibility_config {
      cloudwatch_metrics_enabled = true
      metric_name                = "\${var.project_name}-apprunner-origin-verify"
      sampled_requests_enabled   = true
    }
  }

  visibility_config {
    cloudwatch_metrics_enabled = true
    metric_name                = "\${var.project_name}-apprunner-waf"
    sampled_requests_enabled   = true
  }

  tags = {
    Name        = "\${var.project_name}-\${var.environment}-apprunner-waf"
    Environment = var.environment
    ManagedBy   = "tsdevstack"
  }
}

# =============================================================================
# Instance Role (Runtime) - for Secrets Manager access
# =============================================================================

resource "aws_iam_role" "apprunner_instance" {
  count = length(var.nextjs_services) > 0 ? 1 : 0

  name = "\${var.project_name}-\${var.environment}-apprunner-instance"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action = "sts:AssumeRole"
      Effect = "Allow"
      Principal = {
        Service = "tasks.apprunner.amazonaws.com"
      }
    }]
  })

  tags = {
    Name        = "\${var.project_name}-\${var.environment}-apprunner-instance"
    Environment = var.environment
    ManagedBy   = "tsdevstack"
  }
}

resource "aws_iam_role_policy" "apprunner_instance_secrets" {
  count = length(var.nextjs_services) > 0 ? 1 : 0

  name = "secrets-access"
  role = aws_iam_role.apprunner_instance[0].id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["secretsmanager:GetSecretValue"]
      Resource = "arn:aws:secretsmanager:\${var.aws_region}:\${var.aws_account_id}:secret:\${var.project_name}-*"
    }]
  })
}

# Associate WAF with App Runner services (conditional - only when ARNs provided)
resource "aws_wafv2_web_acl_association" "apprunner" {
  for_each = var.nextjs_service_arns

  resource_arn = each.value
  web_acl_arn  = aws_wafv2_web_acl.apprunner[0].arn
}

# =============================================================================
# Outputs
# =============================================================================

output "apprunner_ecr_access_role_arn" {
  description = "IAM role ARN for App Runner ECR access (used by CLI deployment)"
  value       = length(var.nextjs_services) > 0 ? aws_iam_role.apprunner_ecr_access[0].arn : null
}

output "apprunner_autoscaling_arns" {
  description = "Auto-scaling config ARNs per Next.js service (used by CLI deployment)"
  value       = { for name, cfg in aws_apprunner_auto_scaling_configuration_version.nextjs : name => cfg.arn }
}

output "apprunner_instance_role_arn" {
  description = "IAM instance role ARN for App Runner runtime (Secrets Manager access)"
  value       = length(var.nextjs_services) > 0 ? aws_iam_role.apprunner_instance[0].arn : null
}

output "apprunner_origin_verify_secret" {
  description = "Secret header value for App Runner origin verification (used by CloudFront)"
  value       = length(var.nextjs_services) > 0 ? random_password.apprunner_origin_secret[0].result : null
  sensitive   = true
}
"
`;
