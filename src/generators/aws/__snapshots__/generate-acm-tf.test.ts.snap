// Rstest Snapshot v1

exports[`generateAcmTf > snapshot > should match snapshot 1`] = `
"# ACM SSL Certificates + Route 53 DNS Validation
# Generated by: npx tsdevstack infra:generate
#
# Two certificates required:
# 1. CloudFront certificate (us-east-1) - CloudFront requires certs in us-east-1
# 2. Regional certificate (main region) - ALB requires certs in same region
#
# IMPORTANT: Same AWS account + same domain = same DNS validation record.
# We create ONE set of DNS records, both certs use them for validation.
# See: https://docs.aws.amazon.com/acm/latest/userguide/dns-validation.html

# =============================================================================
# Domain locals
# var.base_domain = "createdevstack.app" (base domain from DOMAIN secret)
# Subdomains are derived: api.base_domain, app.base_domain, etc.
# =============================================================================

locals {
  # Derived subdomains
  api_domain = var.base_domain != "" ? "api.\${var.base_domain}" : ""

  # Certificate ARNs for different resources
  # CloudFront requires us-east-1, ALB requires same region as ALB
  cloudfront_certificate_arn = var.base_domain != "" ? aws_acm_certificate_validation.cloudfront[0].certificate_arn : null
  regional_certificate_arn   = var.base_domain != "" ? aws_acm_certificate_validation.regional[0].certificate_arn : null
}

# =============================================================================
# Route 53 Hosted Zone Lookup
# Must exist before deployment - created manually via AWS Console
# =============================================================================

data "aws_route53_zone" "main" {
  count = var.base_domain != "" ? 1 : 0
  name  = var.base_domain
}

# =============================================================================
# DNS Validation Records (SHARED by both certificates)
# Same account + same domain = same validation record
# Use resource_record_name as key to handle base domain + wildcard sharing
# =============================================================================

resource "aws_route53_record" "cert_validation" {
  # Use domain_name as key because it's known at plan time (derived from our input).
  # resource_record_name is only known after apply for new certificates.
  # With allow_overwrite = true, duplicate DNS records (if base + wildcard share
  # the same validation record) are handled gracefully.
  for_each = var.base_domain != "" ? {
    for dvo in aws_acm_certificate.cloudfront[0].domain_validation_options : dvo.domain_name => {
      name   = dvo.resource_record_name
      record = dvo.resource_record_value
      type   = dvo.resource_record_type
    }
  } : {}

  zone_id = data.aws_route53_zone.main[0].zone_id
  name    = each.value.name
  type    = each.value.type
  records = [each.value.record]
  ttl     = 60

  allow_overwrite = true
}

# =============================================================================
# CloudFront Certificate (us-east-1)
# Required for all CloudFront distributions
# =============================================================================

resource "aws_acm_certificate" "cloudfront" {
  provider = aws.us_east_1
  count    = var.base_domain != "" ? 1 : 0

  domain_name               = var.base_domain
  subject_alternative_names = ["*.\${var.base_domain}"]
  validation_method         = "DNS"

  lifecycle {
    create_before_destroy = true
  }

  tags = { Name = "\${var.project_name}-cloudfront-cert" }
}

resource "aws_acm_certificate_validation" "cloudfront" {
  provider = aws.us_east_1
  count    = var.base_domain != "" ? 1 : 0

  certificate_arn         = aws_acm_certificate.cloudfront[0].arn
  validation_record_fqdns = [for record in aws_route53_record.cert_validation : record.fqdn]

  timeouts {
    create = "10m"
  }
}

# =============================================================================
# Regional Certificate (main region)
# Required for ALB (must be in same region as ALB)
# =============================================================================

resource "aws_acm_certificate" "regional" {
  count = var.base_domain != "" ? 1 : 0

  domain_name               = var.base_domain
  subject_alternative_names = ["*.\${var.base_domain}"]
  validation_method         = "DNS"

  lifecycle {
    create_before_destroy = true
  }

  tags = { Name = "\${var.project_name}-regional-cert" }
}

resource "aws_acm_certificate_validation" "regional" {
  count = var.base_domain != "" ? 1 : 0

  certificate_arn         = aws_acm_certificate.regional[0].arn
  # Uses the SAME DNS records as cloudfront cert (same account = same validation)
  validation_record_fqdns = [for record in aws_route53_record.cert_validation : record.fqdn]

  timeouts {
    create = "10m"
  }
}

# =============================================================================
# Outputs
# =============================================================================

output "cloudfront_certificate_arn" {
  description = "ARN of the CloudFront ACM certificate (us-east-1)"
  value       = var.base_domain != "" ? aws_acm_certificate.cloudfront[0].arn : null
}

output "regional_certificate_arn" {
  description = "ARN of the regional ACM certificate (for ALB)"
  value       = var.base_domain != "" ? aws_acm_certificate.regional[0].arn : null
}

output "route53_zone_id" {
  description = "Route 53 hosted zone ID"
  value       = var.base_domain != "" ? data.aws_route53_zone.main[0].zone_id : null
}
"
`;
