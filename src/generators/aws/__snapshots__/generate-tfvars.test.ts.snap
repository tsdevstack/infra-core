// Rstest Snapshot v1

exports[`generateTfvars > snapshot > should match snapshot for full config 1`] = `
"# Variable values
# Generated by: npx tsdevstack infra:generate

project_name   = "my-app"
environment    = "dev"
aws_region     = "us-east-1"
aws_account_id = "123456789012"

# Base domain (Route 53 hosted zone looked up via data source)
# Subdomains (api., app., etc.) are derived in Terraform
base_domain = "example.com"

# Services (ECS)
services = {
  "auth-service" = {
    cpu          = 256
    memory       = 512
    minInstances = 1
    maxInstances = 4
    dbPoolMax    = 18
    logLevel     = "info"
  }
  "bff-service" = {
    cpu          = 512
    memory       = 1024
    minInstances = 0
    maxInstances = 2
    dbPoolMax    = 37
    logLevel     = "info"
  }
  "kong" = {
    cpu          = 256
    memory       = 512
    minInstances = 1
    maxInstances = 4
    dbPoolMax    = 0
    logLevel     = "info"
  }
}

workers = {
  "auth-worker" = {
    cpu          = 256
    memory       = 512
    minInstances = 1
    maxInstances = 3
    service      = "auth-service"
    dbPoolMax    = 8
    logLevel     = "info"
  }
}

all_deployables = {
  "auth-service" = "auth-service"
  "bff-service" = "bff-service"
  "kong" = "kong"
  "auth-worker" = "auth-worker"
}

# SPA Services
spa_services = {
  "frontend" = {
    domain = "app.example.com"
  }
}

# Next.js Services (ECS Fargate + CloudFront)
nextjs_services = {
  "admin-portal" = {
    domain       = "admin.example.com"
    cpu          = 256
    memory       = 512
    minInstances = 1
    maxInstances = 3
  }
}

# Scheduled Jobs
scheduled_jobs = {
  "auth-service-cleanup" = {
    schedule       = "cron(0 * * * ? *)"
    serviceName    = "auth-service"
    path           = "/api/internal/cleanup"
    method         = "POST"
    timeoutSeconds = 300
    timezone       = "UTC"
  }
}

# Cron Jobs (an ECS task started by its schedule)
cron_jobs = {}

# Database (RDS PostgreSQL)
db_instance_class            = "db.t3.micro"
database_storage_size        = 20
database_deletion_protection = false
database_backup              = false
database_ha                  = false

# Redis (ElastiCache)
redis_node_type = "cache.t3.micro"

# Tracing: share of new traces kept (tracing.sampleRate)
trace_sample_rate = 1
"
`;

exports[`generateTfvars > snapshot > should match snapshot for minimal config 1`] = `
