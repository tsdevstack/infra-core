// Rstest Snapshot v1

exports[`generateDatabaseTf > snapshot > should match snapshot 1`] = `
"# RDS PostgreSQL Database
# Generated by: npx tsdevstack infra:generate

# =============================================================================
# DB Subnet Group
# =============================================================================

resource "aws_db_subnet_group" "main" {
  name        = "\${var.project_name}-db"
  description = "Database subnet group for \${var.project_name}"
  subnet_ids  = aws_subnet.private[*].id

  tags = { Name = "\${var.project_name}-db" }
}

# =============================================================================
# Master Password
# =============================================================================

resource "random_password" "db_master" {
  length  = 32
  special = false
}

# Suffix for the final snapshot: a fixed name makes the next destroy in the
# same account fail once a snapshot with that name exists.
resource "random_id" "db_final_snapshot" {
  byte_length = 4
}

# =============================================================================
# RDS PostgreSQL Instance
# =============================================================================

resource "aws_db_instance" "main" {
  identifier     = "\${var.project_name}-db"
  engine         = "postgres"
  engine_version = "15"
  instance_class = var.db_instance_class

  db_name  = "postgres"
  username = "postgres"
  password = random_password.db_master.result

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = false
  multi_az               = var.database_ha

  # Autoscaling ceiling (max_allocated_storage) must stay above the allocated size
  allocated_storage     = var.database_storage_size
  max_allocated_storage = max(100, var.database_storage_size * 2)
  storage_type          = "gp3"
  storage_encrypted     = true

  # Retention 0 turns automated backups (and point-in-time recovery) off;
  # the backup window is left unset then
  backup_retention_period   = var.database_backup ? 7 : 0
  backup_window             = var.database_backup ? "03:00-04:00" : null
  maintenance_window        = "Mon:04:00-Mon:05:00"
  deletion_protection       = var.database_deletion_protection
  skip_final_snapshot       = false
  final_snapshot_identifier = "\${var.project_name}-db-final-\${random_id.db_final_snapshot.hex}"

  # SQL statistics per query (Database Insights, standard mode); 7 days of
  # history are free. Turning it on or off doesn't restart the database.
  performance_insights_enabled          = true
  performance_insights_retention_period = 7

  tags = { Name = "\${var.project_name}-db" }
}

# =============================================================================
# Store Master Password in Secrets Manager
# =============================================================================

resource "aws_secretsmanager_secret" "db_master_password" {
  name        = "\${var.project_name}-db-master-password"
  description = "RDS master password for \${var.project_name}"

  # Delete immediately on destroy: the default 30-day recovery window keeps
  # the name taken, so recreating the environment would fail.
  recovery_window_in_days = 0

  tags = { Name = "\${var.project_name}-db-master-password" }
}

resource "aws_secretsmanager_secret_version" "db_master_password" {
  secret_id     = aws_secretsmanager_secret.db_master_password.id
  secret_string = random_password.db_master.result
}

# =============================================================================
# Saved databases: infra:remove-service saves a service's database here
# before it drops it, and infra:restore-database saves the current contents
# before it replaces them ({service}/{time}-{reason}.dump). One bucket for the
# environment: a bucket per service would go with the service at the next
# deploy, and its file with it. Files are deleted after 7 days (no
# versions are kept); destroy deletes the bucket and its files.
# =============================================================================

resource "aws_s3_bucket" "db_exports" {
  bucket        = "\${var.project_name}-db-exports-\${var.aws_account_id}"
  force_destroy = true

  tags = { Name = "\${var.project_name}-db-exports" }
}

resource "aws_s3_bucket_public_access_block" "db_exports" {
  bucket = aws_s3_bucket.db_exports.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_policy" "db_exports" {
  depends_on = [aws_s3_bucket_public_access_block.db_exports]
  bucket     = aws_s3_bucket.db_exports.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "DenyInsecureTransport"
        Effect    = "Deny"
        Principal = "*"
        Action    = "s3:*"
        Resource  = [aws_s3_bucket.db_exports.arn, "\${aws_s3_bucket.db_exports.arn}/*"]
        Condition = {
          Bool = {
            "aws:SecureTransport" = "false"
          }
        }
      }
    ]
  })
}

resource "aws_s3_bucket_lifecycle_configuration" "db_exports" {
  bucket = aws_s3_bucket.db_exports.id

  rule {
    id     = "delete-saved-databases"
    status = "Enabled"

    filter {}

    expiration {
      days = 7
    }

    # A save that stopped halfway leaves parts of an upload behind
    abort_incomplete_multipart_upload {
      days_after_initiation = 1
    }
  }
}

# Only db-init (its task role) writes and reads the files: it can't delete
# them. The deploy account lists them (the check before a removal, the
# choice of file for a restore).
resource "aws_iam_role_policy" "db_init_exports" {
  name = "db-exports-access"
  role = aws_iam_role.db_init_task.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "SaveAndReadDatabases"
        Effect   = "Allow"
        Action   = ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload"]
        Resource = ["\${aws_s3_bucket.db_exports.arn}/*"]
      },
      {
        # A missing file then reads as missing, not as access denied
        Sid      = "ListSavedDatabases"
        Effect   = "Allow"
        Action   = ["s3:ListBucket"]
        Resource = [aws_s3_bucket.db_exports.arn]
      }
    ]
  })
}
"
`;
