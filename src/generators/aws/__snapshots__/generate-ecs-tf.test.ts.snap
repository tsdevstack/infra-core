// Rstest Snapshot v1

exports[`generateEcsTf > snapshot > should match snapshot 1`] = `
"# ECS Cluster, Services, and Workers
# Generated by: npx tsdevstack infra:generate

# =============================================================================
# ECS Cluster
# =============================================================================

resource "aws_ecs_cluster" "main" {
  name = "\${var.project_name}-cluster"

  setting {
    name  = "containerInsights"
    value = "enabled"
  }

  tags = { Name = "\${var.project_name}-cluster" }
}

# =============================================================================
# CloudWatch Log Groups
# =============================================================================

resource "aws_cloudwatch_log_group" "service" {
  for_each          = var.services
  name              = "/ecs/\${var.project_name}/\${each.key}"
  retention_in_days = 30
  kms_key_id        = aws_kms_key.logs.arn

  tags = { Name = "\${var.project_name}-\${each.key}-logs" }
}

resource "aws_cloudwatch_log_group" "worker" {
  for_each          = var.workers
  name              = "/ecs/\${var.project_name}/\${each.key}"
  retention_in_days = 30
  kms_key_id        = aws_kms_key.logs.arn

  tags = { Name = "\${var.project_name}-\${each.key}-logs" }
}

# =============================================================================
# Task Definitions (Services)
# =============================================================================

resource "aws_ecs_task_definition" "service" {
  for_each = var.services

  family                   = "\${var.project_name}-\${each.key}"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = each.value.cpu
  memory                   = each.value.memory
  execution_role_arn       = aws_iam_role.ecs_execution.arn
  task_role_arn            = aws_iam_role.task[each.key].arn

  container_definitions = jsonencode([{
    name  = each.key
    image = "\${aws_ecr_repository.service[each.key].repository_url}:latest"

    portMappings = [{
      containerPort = 8080
      protocol      = "tcp"
    }]

    # Base environment variables for all services
    # Kong gets additional vars for wake-up post-function plugin
    environment = concat(
      [
        { name = "NODE_ENV", value = "production" },
        { name = "PORT", value = "8080" },
        { name = "SERVICE_NAME", value = each.key },
        { name = "CLOUD_PROVIDER", value = "aws" },
        { name = "SECRETS_PROVIDER", value = "aws" },
        { name = "AWS_REGION", value = var.aws_region },
        { name = "PROJECT_NAME", value = var.project_name },
        { name = "DB_POOL_MAX", value = tostring(each.value.dbPoolMax) },
      ],
      each.key == "kong" ? [
        # Kong proxy port - must match ALB target group and ECS health check (8080)
        { name = "KONG_PROXY_LISTEN", value = "0.0.0.0:8080" },
        # Wake-up Lambda URL for post-function plugin (scale-to-zero support)
        { name = "WAKEUP_LAMBDA_URL", value = aws_lambda_function_url.wakeup.function_url },
        # Whitelist resty.http for post-function plugin Lua code
        { name = "KONG_UNTRUSTED_LUA_SANDBOX_REQUIRES", value = "resty.http" },
        # Allow Lua sandbox to read WAKEUP_LAMBDA_URL via os.getenv()
        { name = "KONG_UNTRUSTED_LUA_SANDBOX_ENVIRONMENT", value = "WAKEUP_LAMBDA_URL" },
        # Use VPC DNS to resolve Cloud Map service names (auth-service.tsdevstack.local)
        # VPC DNS is at CIDR base + 2 (10.0.0.2 for 10.0.0.0/16 VPC)
        { name = "KONG_DNS_RESOLVER", value = "10.0.0.2" },
      ] : []
    )

    # Note: Secrets are injected via CLI deployment, not hard-coded here
    # The deployment process updates the task definition with secret ARNs

    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = "/ecs/\${var.project_name}/\${each.key}"
        "awslogs-region"        = var.aws_region
        "awslogs-stream-prefix" = "ecs"
      }
    }

    # Kong uses custom health check script for OIDC warmup (zero-downtime deployment)
    # Script polls for up to 50s, so timeout must be 60s. startPeriod gives extra grace.
    # Other services use standard /health endpoint
    healthCheck = {
      command     = each.key == "kong" ? ["CMD-SHELL", "/usr/local/bin/kong-health-check.sh"] : ["CMD-SHELL", "curl -f http://localhost:8080/health || exit 1"]
      interval    = 30
      timeout     = each.key == "kong" ? 60 : 5   # Kong: 60s (script polls up to 50s)
      retries     = 3
      startPeriod = each.key == "kong" ? 180 : 60  # Kong: 3min grace for auth-service wake-up
    }
  }])

  tags = { Name = "\${var.project_name}-\${each.key}-task" }
}

# =============================================================================
# ECS Services
# =============================================================================

resource "aws_ecs_service" "service" {
  for_each = var.services

  name            = each.key
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.service[each.key].arn
  desired_count   = max(each.value.minInstances, 1)  # At least 1 for initial deploy
  launch_type     = "FARGATE"

  # Grace period before ALB health checks start (gives container time to start)
  health_check_grace_period_seconds = 120

  # Zero-downtime deployment: keep old task until new one is healthy
  deployment_minimum_healthy_percent = 100
  deployment_maximum_percent         = 200

  # Circuit breaker: automatically fail stuck deployments and rollback
  # Prevents zombie deployments from competing with new ones
  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  network_configuration {
    subnets          = aws_subnet.private[*].id
    security_groups  = [aws_security_group.ecs.id]
    assign_public_ip = false
  }

  # All services get load balancer for ALB internal routing
  load_balancer {
    target_group_arn = aws_lb_target_group.service[each.key].arn
    container_name   = each.key
    container_port   = 8080
  }

  # Backend services register with Cloud Map for service-to-service discovery
  # Kong doesn't need Cloud Map (it uses ALB for upstream routing)
  dynamic "service_registries" {
    for_each = each.key != "kong" ? [1] : []
    content {
      registry_arn = aws_service_discovery_service.service[each.key].arn
    }
  }

  depends_on = [aws_lb_listener.https]

  tags = { Name = "\${var.project_name}-\${each.key}-service" }

  lifecycle {
    # task_definition: CLI creates task defs with secrets, Terraform shouldn't override
    # desired_count: Auto-scaling manages this
    ignore_changes = [task_definition, desired_count]
  }
}

# =============================================================================
# Task Definitions (Workers)
# =============================================================================

resource "aws_ecs_task_definition" "worker" {
  for_each = var.workers

  family                   = "\${var.project_name}-\${each.key}"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = each.value.cpu
  memory                   = each.value.memory
  execution_role_arn       = aws_iam_role.ecs_execution.arn
  task_role_arn            = aws_iam_role.task[each.value.service].arn

  container_definitions = jsonencode([{
    name  = each.key
    image = "\${aws_ecr_repository.service[each.value.service].repository_url}:latest"

    environment = [
      { name = "NODE_ENV", value = "production" },
      { name = "SERVICE_NAME", value = each.value.service },
      { name = "WORKER_NAME", value = each.key },
      { name = "CLOUD_PROVIDER", value = "aws" },
      { name = "SECRETS_PROVIDER", value = "aws" },
      { name = "AWS_REGION", value = var.aws_region },
      { name = "PROJECT_NAME", value = var.project_name },
      { name = "DB_POOL_MAX", value = tostring(each.value.dbPoolMax) },
    ]

    logConfiguration = {
      logDriver = "awslogs"
      options = {
        "awslogs-group"         = "/ecs/\${var.project_name}/\${each.key}"
        "awslogs-region"        = var.aws_region
        "awslogs-stream-prefix" = "ecs"
      }
    }
  }])

  tags = { Name = "\${var.project_name}-\${each.key}-task" }
}

# =============================================================================
# ECS Services (Workers - Always Running)
# Workers poll Redis and cannot scale to zero
# =============================================================================

resource "aws_ecs_service" "worker" {
  for_each = var.workers

  name            = each.key
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.worker[each.key].arn
  desired_count   = 1  # Always at least 1
  launch_type     = "FARGATE"

  # Zero-downtime deployment: keep old task until new one is healthy
  deployment_minimum_healthy_percent = 100
  deployment_maximum_percent         = 200

  # Circuit breaker: automatically fail stuck deployments and rollback
  # Prevents zombie deployments from competing with new ones
  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  network_configuration {
    subnets          = aws_subnet.private[*].id
    security_groups  = [aws_security_group.ecs.id]
    assign_public_ip = false
  }

  # Workers don't receive HTTP traffic - no load_balancer
  # Workers aren't called by name - no service_registries

  tags = { Name = "\${var.project_name}-\${each.key}-worker" }

  lifecycle {
    # task_definition: CLI creates task defs with secrets, Terraform shouldn't override
    # desired_count: Auto-scaling manages this
    ignore_changes = [task_definition, desired_count]
  }
}
"
`;
