// Rstest Snapshot v1

exports[`generateRoute53Tf > snapshot > should match snapshot 1`] = `
"# Route 53 DNS A Records
# Generated by: npx tsdevstack infra:generate
#
# Creates DNS A records pointing to CloudFront.
# Route 53 hosted zone lookup is in acm.tf.

# =============================================================================
# API Domain A Record (e.g., api.createdevstack.app -> API CloudFront)
# =============================================================================

resource "aws_route53_record" "api" {
  count = var.base_domain != "" ? 1 : 0

  zone_id = data.aws_route53_zone.main[0].zone_id
  name    = local.api_domain
  type    = "A"

  alias {
    name                   = aws_cloudfront_distribution.main.domain_name
    zone_id                = aws_cloudfront_distribution.main.hosted_zone_id
    evaluate_target_health = false
  }
}
"
`;
