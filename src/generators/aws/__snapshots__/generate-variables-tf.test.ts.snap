// Rstest Snapshot v1

exports[`generateVariablesTf > snapshot > should match snapshot 1`] = `
"# Input variables
# Generated by: npx tsdevstack infra:generate

variable "project_name" {
  description = "Project name used for resource naming"
  type        = string
}

variable "environment" {
  description = "Environment name (dev, staging, prod)"
  type        = string
}

variable "aws_region" {
  description = "AWS region for resources"
  type        = string
}

variable "aws_account_id" {
  description = "AWS account ID"
  type        = string
}

# ─────────────────────────────────────────
# Domain & SSL
# Route 53 hosted zone is looked up via data source (must exist before deploy)
# ─────────────────────────────────────────

variable "base_domain" {
  description = "Base domain for the application (e.g., example.com). Route 53 hosted zone must exist. Subdomains (api., app., etc.) are derived automatically."
  type        = string
}

# ─────────────────────────────────────────
# Services (ECS)
# ─────────────────────────────────────────

variable "services" {
  description = "Map of services with their resource configuration"
  type = map(object({
    cpu          = number
    memory       = number
    minInstances = number  # 0 = can scale to zero, 1+ = always running
    maxInstances = number
    dbPoolMax    = number  # Database connection pool size per instance
  }))
}

variable "workers" {
  description = "Map of workers with their resource configuration"
  type = map(object({
    cpu          = number
    memory       = number
    minInstances = number  # 1+ (workers must always run for queue polling)
    maxInstances = number
    service      = string  # The base service this worker belongs to
    dbPoolMax    = number  # Database connection pool size per instance
  }))
  default = {}
}

variable "all_deployables" {
  description = "Map of all deployables (services + workers + kong) for ECR"
  type        = map(string)
}

# ─────────────────────────────────────────
# SPA Services
# ─────────────────────────────────────────

variable "spa_services" {
  description = "Map of SPA services with their domains"
  type = map(object({
    domain = string
  }))
  default = {}
}

# ─────────────────────────────────────────
# Next.js Services (ECS + CloudFront)
# ─────────────────────────────────────────

variable "nextjs_services" {
  description = "Map of Next.js services with their configuration"
  type = map(object({
    domain       = string
    cpu          = number
    memory       = number
    minInstances = number
    maxInstances = number
  }))
  default = {}
}

# ─────────────────────────────────────────
# Scheduled Jobs
# ─────────────────────────────────────────

variable "scheduled_jobs" {
  description = "Map of scheduled jobs"
  type = map(object({
    schedule    = string  # EventBridge schedule expression (e.g., cron(0 * * * ? *))
    serviceName = string
    path        = string
  }))
  default = {}
}

# ─────────────────────────────────────────
# Database (RDS PostgreSQL)
# ─────────────────────────────────────────

variable "db_instance_class" {
  description = "RDS instance class (e.g., db.t3.micro, db.t3.small)"
  type        = string
  default     = "db.t3.micro"
}

variable "database_storage_size" {
  description = "RDS storage size in GB"
  type        = number
  default     = 20
}

variable "database_deletion_protection" {
  description = "Enable deletion protection"
  type        = bool
  default     = true
}

variable "database_backup" {
  description = "Enable automated backups"
  type        = bool
  default     = true
}

# ─────────────────────────────────────────
# Redis (ElastiCache)
# ─────────────────────────────────────────

variable "redis_node_type" {
  description = "ElastiCache node type (e.g., cache.t3.micro, cache.t3.small)"
  type        = string
  default     = "cache.t3.micro"
}

variable "redis_high_availability" {
  description = "Enable Multi-AZ with automatic failover"
  type        = bool
  default     = false
}

# ─────────────────────────────────────────
# Deployed Origins (detected by CLI)
# ─────────────────────────────────────────

variable "spa_buckets_ready" {
  description = "SPA buckets that have content deployed (detected by CLI)"
  type        = map(bool)
  default     = {}
}
"
`;

