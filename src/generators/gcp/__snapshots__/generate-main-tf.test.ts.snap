// Rstest Snapshot v1

exports[`generateMainTf > snapshot > should match snapshot for dev environment 1`] = `
"# Terraform configuration
# Generated by: npx tsdevstack infra:generate

terraform {
  required_version = ">= 1.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
  }

  backend "gcs" {
    bucket = "my-app-tf-state"
    prefix = "dev"
  }
}

provider "google" {
  project = var.gcp_project_id
  region  = var.gcp_region
}
"
`;

exports[`generateMainTf > snapshot > should match snapshot for prod environment 1`] = `
"# Terraform configuration
# Generated by: npx tsdevstack infra:generate

terraform {
  required_version = ">= 1.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
  }

  backend "gcs" {
    bucket = "production-app-tf-state"
    prefix = "prod"
  }
}

provider "google" {
  project = var.gcp_project_id
  region  = var.gcp_region
}
"
`;
