// Rstest Snapshot v1

exports[`generateNetworkTf > snapshot > should match snapshot 1`] = `
"# Network Infrastructure
# Generated by: npx tsdevstack infra:generate

# 1. VPC Network
resource "google_compute_network" "vpc" {
  name                    = "\${var.project_name}-vpc"
  auto_create_subnetworks = false
  description             = "VPC for \${var.project_name} microservices"
}

# 2. Main Subnet with Private Google Access
# Cloud Run services use Direct VPC Egress to get IPs directly in this subnet
resource "google_compute_subnetwork" "subnet" {
  name                     = "\${var.project_name}-subnet"
  network                  = google_compute_network.vpc.id
  region                   = var.gcp_region
  ip_cidr_range            = "10.0.0.0/20"
  private_ip_google_access = true
  description              = "Main subnet for \${var.project_name} services (Direct VPC Egress)"
}

# 3. Private Service Access for Cloud SQL
resource "google_compute_global_address" "private_ip_range" {
  name          = "\${var.project_name}-private-ip-range"
  purpose       = "VPC_PEERING"
  address_type  = "INTERNAL"
  prefix_length = 16
  network       = google_compute_network.vpc.id
  description   = "Reserved IP range for Private Service Access (Cloud SQL)"
}

resource "google_service_networking_connection" "private_service_connection" {
  network                 = google_compute_network.vpc.id
  service                 = "servicenetworking.googleapis.com"
  reserved_peering_ranges = [google_compute_global_address.private_ip_range.name]
}

# 4. Firewall rule - Allow internal traffic
resource "google_compute_firewall" "allow_internal" {
  name        = "\${var.project_name}-allow-internal"
  network     = google_compute_network.vpc.id
  description = "Allow internal traffic within VPC"
  direction   = "INGRESS"

  allow {
    protocol = "tcp"
    ports    = ["0-65535"]
  }

  allow {
    protocol = "udp"
    ports    = ["0-65535"]
  }

  allow {
    protocol = "icmp"
  }

  source_ranges = ["10.0.0.0/8"]
}

# 5. Private DNS Zone for Cloud Run internal service-to-service routing
# Without this, traffic to *.run.app goes to public internet and returns 404
# for services with internal-only ingress, even with Direct VPC Egress configured.
# This routes run.app DNS queries to private.googleapis.com IPs.
resource "google_dns_managed_zone" "run_app_internal" {
  name        = "\${var.project_name}-run-app-internal"
  dns_name    = "run.app."
  description = "Private DNS zone for internal Cloud Run service-to-service calls"
  visibility  = "private"

  private_visibility_config {
    networks {
      network_url = google_compute_network.vpc.id
    }
  }
}

# A record pointing to private.googleapis.com range
resource "google_dns_record_set" "run_app_a" {
  managed_zone = google_dns_managed_zone.run_app_internal.name
  name         = "run.app."
  type         = "A"
  ttl          = 300
  rrdatas      = ["199.36.153.8", "199.36.153.9", "199.36.153.10", "199.36.153.11"]
}

# Wildcard A record for *.run.app -> private.googleapis.com
resource "google_dns_record_set" "run_app_wildcard" {
  managed_zone = google_dns_managed_zone.run_app_internal.name
  name         = "*.run.app."
  type         = "A"
  ttl          = 300
  rrdatas      = ["199.36.153.8", "199.36.153.9", "199.36.153.10", "199.36.153.11"]
}
"
`;
