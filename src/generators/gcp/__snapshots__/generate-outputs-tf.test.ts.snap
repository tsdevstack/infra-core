// Rstest Snapshot v1

exports[`generateOutputsTf > snapshot > should match snapshot 1`] = `
"# Stack outputs
# Generated by: npx tsdevstack infra:generate

output "vpc_name" {
  description = "Name of the VPC network"
  value       = google_compute_network.vpc.name
}

output "vpc_id" {
  description = "ID of the VPC network"
  value       = google_compute_network.vpc.id
}

output "subnet_name" {
  description = "Name of the subnet"
  value       = google_compute_subnetwork.subnet.name
}

output "subnet_id" {
  description = "ID of the subnet"
  value       = google_compute_subnetwork.subnet.id
}

output "private_service_connection_peering" {
  description = "Peering name for private service connection"
  value       = google_service_networking_connection.private_service_connection.peering
}

output "runtime_service_account_emails" {
  description = "Map of service name to runtime service account email"
  value       = { for k, v in google_service_account.runtime : k => v.email }
}

output "kong_service_account_email" {
  description = "Kong Gateway runtime service account email"
  value       = google_service_account.kong.email
}

# ─────────────────────────────────────────
# Project
# ─────────────────────────────────────────

output "project_number" {
  description = "GCP project number (used for deterministic Cloud Run URLs)"
  value       = data.google_project.current.number
}

# ─────────────────────────────────────────
# Database (Cloud SQL)
# ─────────────────────────────────────────

output "database_instance_name" {
  description = "Name of the Cloud SQL instance"
  value       = google_sql_database_instance.postgres.name
}

output "database_connection_name" {
  description = "Connection name for Cloud SQL (project:region:instance)"
  value       = google_sql_database_instance.postgres.connection_name
}

output "database_private_ip" {
  description = "Private IP address of the Cloud SQL instance"
  value       = google_sql_database_instance.postgres.private_ip_address
}

# ─────────────────────────────────────────
# Redis (Memorystore)
# ─────────────────────────────────────────

output "redis_host" {
  description = "Redis instance host (private IP)"
  value       = google_redis_instance.redis.host
}

output "redis_port" {
  description = "Redis instance port"
  value       = google_redis_instance.redis.port
}

output "redis_auth_string" {
  description = "Redis AUTH string (password) - sync to Secret Manager after deploy"
  value       = google_redis_instance.redis.auth_string
  sensitive   = true
}

output "redis_current_location_id" {
  description = "Current location of the Redis instance"
  value       = google_redis_instance.redis.current_location_id
}

# ─────────────────────────────────────────
# Artifact Registry
# ─────────────────────────────────────────

output "artifact_registry_url" {
  description = "Base URL for Docker images"
  value       = "\${var.gcp_region}-docker.pkg.dev/\${var.gcp_project_id}/\${google_artifact_registry_repository.services.repository_id}"
}
"
`;
