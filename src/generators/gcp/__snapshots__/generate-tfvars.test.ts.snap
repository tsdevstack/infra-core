// Rstest Snapshot v1

exports[`generateTfvars > snapshots > should match snapshot for dev config 1`] = `
"# Variable values
# Generated by: npx tsdevstack infra:generate

project_name   = "my-app"
gcp_project_id = "gcp-project-123"
gcp_region     = "us-central1"

# Database (Cloud SQL)
database_deletion_protection = true
database_tier                = "db-f1-micro"
database_disk_size           = 10
database_ha                  = false
database_backup              = false

# Redis (Memorystore)
redis_tier      = "BASIC"
redis_memory_gb = 1
"
`;

exports[`generateTfvars > snapshots > should match snapshot for prod config 1`] = `
"# Variable values
# Generated by: npx tsdevstack infra:generate

project_name   = "my-app"
gcp_project_id = "my-app-prod-123"
gcp_region     = "us-east1"

# Database (Cloud SQL)
database_deletion_protection = true
database_tier                = "db-custom-2-8192"
database_disk_size           = 100
database_ha                  = true
database_backup              = true

# Redis (Memorystore)
redis_tier      = "STANDARD_HA"
redis_memory_gb = 8
"
`;
