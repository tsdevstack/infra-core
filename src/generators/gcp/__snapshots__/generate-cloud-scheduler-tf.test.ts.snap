// Rstest Snapshot v1

exports[`generateCloudSchedulerTf > snapshot > should match snapshot for empty jobs 1`] = `
"# No scheduled jobs configured
# Add scheduledJobs in infrastructure.json to generate Cloud Scheduler resources
"
`;

exports[`generateCloudSchedulerTf > snapshot > should match snapshot for single job 1`] = `
"# Cloud Scheduler Infrastructure
# Generated by: npx tsdevstack infra:generate
#
# Scheduled jobs call service endpoints with OIDC authentication.
# Services validate tokens using SchedulerGuard from @tsdevstack/nest-common.
#
# Cloud Run URLs are computed from project number (no dependency on existing services).
# IAM bindings (run.invoker) are set by deploy-schedulers via SDK, not Terraform.

# ─────────────────────────────────────────
# Computed Service URIs
# ─────────────────────────────────────────

locals {
  scheduler_service_uris = {
    auth_service = "https://auth-service-\${data.google_project.current.number}.\${var.gcp_region}.run.app"
  }
}

# ─────────────────────────────────────────
# Service Account
# ─────────────────────────────────────────

# Service account for Cloud Scheduler
resource "google_service_account" "scheduler" {
  account_id   = "\${var.project_name}-scheduler"
  display_name = "Cloud Scheduler Service Account"
  description  = "Service account for Cloud Scheduler to invoke Cloud Run services"
}

# ─────────────────────────────────────────
# Scheduled Jobs
# ─────────────────────────────────────────

# Scheduled job: cleanup-tokens
resource "google_cloud_scheduler_job" "cleanup_tokens" {
  name     = "cleanup-tokens"
  schedule = "0 */4 * * *"
  time_zone = "UTC"

  http_target {
    uri         = "\${local.scheduler_service_uris.auth_service}/jobs/cleanup-tokens"
    http_method = "POST"

    oidc_token {
      service_account_email = google_service_account.scheduler.email
      audience              = local.scheduler_service_uris.auth_service
    }
  }

  retry_config {
    retry_count          = 3
    min_backoff_duration = "5s"
    max_backoff_duration = "3600s"
    max_doublings        = 5
  }

  attempt_deadline = "300s"
}
"
`;
