    expression  = "resource.name.startsWith(\\"projects/\${data.google_project.current.number}/secrets/\${var.project_name}-shared-\\") || resource.name.startsWith(\\"projects/\${data.google_project.current.number}/secrets/\${var.project_name}-\${each.key}-\\") && !(resource.name == \\"projects/\${data.google_project.current.number}/secrets/\${var.project_name}-\${each.key}-MIGRATION_DATABASE_URL\\" || resource.name.startsWith(\\"projects/\${data.google_project.current.number}/secrets/\${var.project_name}-\${each.key}-MIGRATION_DATABASE_URL/\\"))"
  }

